{
  "name": "proma-mit",
  "version": "0.1.2",
  "description": "The next gen ai software with general agents",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter='@proma/electron' dev",
    "electron:dev": "bun run --filter='@proma/electron' dev",
    "electron:build": "bun run --filter='@proma/electron' build",
    "electron:start": "bun run --filter='@proma/electron' start",
    "build": "bun run --filter='*' build",
    "typecheck": "bun run --filter='*' typecheck",
    "test": "bun test --max-concurrency=1",
    "test:web-bridge-e2e": "playwright test",
    "docs:generate": "bun scripts/generate-doc-facts.ts",
    "docs:check": "bun scripts/generate-doc-facts.ts --check",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@playwright/test": "1.61.0",
    "@types/bun": "latest",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "dompurify": "^3.4.12",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1101.0",
    "jotai": "^2.20.2"
  },
  "overrides": {
    "protobufjs": "^7.5.6",
    "qs": "^6.15.2",
    "body-parser": "^2.3.0",
    "ip-address": "^10.1.1",
    "@hono/node-server": "^2.0.5",
    "hono": "^4.12.18",
    "path-to-regexp": "^8.4.0",
    "fast-uri": "^3.1.3",
    "builder-util-runtime": "^9.7.0",
    "dompurify": "^3.4.12",
    "@xmldom/xmldom": "^0.8.12",
    "linkify-it": "^5.0.1",
    "markdown-it": "^14.1.1",
    "axios": "^1.16.0",
    "form-data": "^4.0.6",
    "follow-redirects": "^1.15.12",
    "postcss": "^8.5.10",
    "ws": "^8.20.1",
    "tmp": "^0.2.6",
    "js-yaml": "^4.1.2",
    "uuid": "^13.0.1",
    "file-type": "^21.3.1",
    "lodash": "^4.17.24",
    "rollup": "^4.59.0",
    "brace-expansion": "^1.1.17",
    "@babel/core": "^7.29.7"
  }
}
