# ============================================================
# Gravitas Server 私有部署环境变量模板
# 复制为 .env 后按需修改：
#   cp .env.example .env
# 说明：默认 authMode=local（本地用户名/密码登录），无需企业 OIDC。
# 若改用企业 OIDC，设 PROMA_WEB_AUTH_MODE=oidc 并填 PROMA_WEB_OIDC_*。
# ============================================================

# ---- 存储（Postgres/S3） ----
PROMA_WEB_S3_BUCKET=proma
PROMA_WEB_S3_REGION=us-east-1
PROMA_WEB_S3_ACCESS_KEY_ID=minioadmin
PROMA_WEB_S3_SECRET_ACCESS_KEY=minioadmin
# 32 字节 Base64 的加密信封密钥（必填；生成：openssl rand -base64 32）
PROMA_WEB_ENVELOPE_KEY=
# 隔离执行器共享令牌（必填；任填一长随机串）
PROMA_WEB_EXECUTOR_TOKEN=

# ---- 浏览器登录（M1） ----
# local（默认，本地用户名/密码）| oidc | both | none
PROMA_WEB_AUTH_MODE=local
# local/both 模式必填：bootstrap 管理员，格式 username:tenantId:password
PROMA_WEB_ADMIN=admin:default:s3cret-pass
# 对外访问的基础 URL（含协议端口），用于登录回调/重定向；反代到 8080 时用 http://<你的域名或IP>:8080
PROMA_WEB_PUBLIC_BASE_URL=http://localhost:8080
# ⚠️ authMode=local/none 时，浏览器登录走会话 cookie，不提供 Bearer JWT 认证
#（local 无 IdP，无法验签 JWT）。dashboard 的「OIDC Bearer token」输入框在 local 模式自动隐藏。
# 需要 Bearer/API token 认证 → 配 oidc/both 模式（走企业 IdP 的 JWT）。

# ---- OIDC（authMode=oidc|both 时才需要） ----
# PROMA_WEB_OIDC_ISSUER=https://your-idp.example.com
# PROMA_WEB_OIDC_AUDIENCE=proma
# PROMA_WEB_OIDC_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json
# PROMA_WEB_OIDC_CLIENT_ID=proma-client
# PROMA_WEB_OIDC_CLIENT_SECRET=
# PROMA_WEB_OIDC_SCOPE=openid profile email

# ---- 可选（私有部署最小集阶段可留空） ----
# PROMA_WEB_ALERT_WEBHOOK_URL=
# PROMA_WEB_SIEM_WEBHOOK_URL=
# PROMA_WEB_AWS_KMS_KEY_ID=
# PROMA_WEB_AWS_REGION=
# PROMA_WEB_AWS_KMS_ENDPOINT=
