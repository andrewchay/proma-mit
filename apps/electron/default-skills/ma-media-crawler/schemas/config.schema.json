{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ma-media-crawler config",
  "description": "MediaCrawler 的 Gravitas Skill 输入配置",
  "type": "object",
  "required": ["platform", "type", "ids"],
  "properties": {
    "platform": {
      "type": "string",
      "description": "目标平台",
      "enum": ["xhs"]
    },
    "type": {
      "type": "string",
      "description": "任务类型",
      "enum": ["detail"]
    },
    "ids": {
      "type": "array",
      "description": "帖子/视频/创作者 ID 列表，支持纯 ID 或完整 URL",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "enable_get_comments": {
      "type": "boolean",
      "description": "是否抓取评论",
      "default": true
    },
    "max_comments": {
      "type": "integer",
      "description": "单帖最大一级评论数",
      "default": 20,
      "minimum": 0,
      "maximum": 500
    },
    "enable_get_sub_comments": {
      "type": "boolean",
      "description": "是否抓取二级评论",
      "default": false
    },
    "cdp_port": {
      "type": "integer",
      "description": "Chrome CDP 调试端口",
      "default": 9222
    },
    "headless": {
      "type": "boolean",
      "description": "是否启用无头模式（CDP 模式下建议 false）",
      "default": false
    },
    "crawler_max_sleep_sec": {
      "type": "integer",
      "description": "爬取间隔最大随机秒数",
      "default": 2,
      "minimum": 1,
      "maximum": 60
    },
    "output_dir": {
      "type": "string",
      "description": "输出目录绝对路径，默认使用当前工作目录"
    },
    "output_filename": {
      "type": "string",
      "description": "输出 CSV 文件名，默认自动生成"
    }
  },
  "additionalProperties": false
}
