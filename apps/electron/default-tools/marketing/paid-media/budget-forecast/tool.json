{
  "id": "ma_forecast_budget",
  "name": "预算预估",
  "description": "计算市场投放预算，评估投放规模，规划预算分配，包含人群规模测算、曝光转化预估、销售占比校验。",
  "domain": "paid-media",
  "parameters": {
    "type": "object",
    "properties": {
      "brand": { "type": "string", "description": "品牌名称" },
      "product": { "type": "string", "description": "产品名称" },
      "market_size": { "type": "number", "description": "目标市场总规模" },
      "ta_description": { "type": "string", "description": "目标受众描述" },
      "ta_penetration_rate": { "type": "number", "description": "目标受众渗透率（百分比）" },
      "annual_sales_target": { "type": "number", "description": "年度销售目标（万元）" },
      "competitor_spend_estimate": { "type": "number", "description": "竞品年投放预估（万元）" },
      "exposure_frequency": { "type": "number", "description": "有效曝光频次" },
      "conversion_rate": { "type": "number", "description": "曝光至购买转化率（百分比）" },
      "budget_ratio": { "type": "number", "description": "营销费用占销售额比例（百分比）" },
      "preferred_platforms": { "type": "string", "description": "首选投放平台，逗号分隔" }
    },
    "required": ["brand", "product", "market_size", "ta_description", "ta_penetration_rate", "annual_sales_target"]
  }
}
