{
  "id": "ma_audit_content",
  "name": "内容审核",
  "description": "审核 KOL 提交的内容稿件，从合规性、品牌契合度、内容质量三个维度评估，给出评分和修改建议。",
  "domain": "influencer",
  "parameters": {
    "type": "object",
    "properties": {
      "brand": { "type": "string", "description": "品牌名称" },
      "product": { "type": "string", "description": "产品名称" },
      "platform": { "type": "string", "description": "平台" },
      "content_type": { "type": "string", "description": "内容类型" },
      "content_description": { "type": "string", "description": "待审核的内容正文或脚本" },
      "kol_id": { "type": "string", "description": "达人 ID（可选）" },
      "content_url": { "type": "string", "description": "内容链接（可选）" }
    },
    "required": ["brand", "product", "content_description"]
  }
}
